{
  "name": "@rp/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "rp-code desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
