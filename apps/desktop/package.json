{
  "name": "@rp/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "rp-code desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build-native.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "package": "node scripts/build-native.mjs && electron-vite build && electron-builder",
    "build:native": "node scripts/build-native.mjs"
  },
  "dependencies": {
    "@rp/shared": "workspace:*",
    "@rp/sdk": "workspace:*",
    "@rp/pack": "workspace:*",
    "@rp/llm": "workspace:*",
    "@rp/sandbox": "workspace:*",
    "@rp/core": "workspace:*",
    "quickjs-emscripten": "^0.32.0",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "marked": "^15.0.0",
    "dompurify": "^3.2.0"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-vite": "^5.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^22",
    "@types/dompurify": "^3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "dev.rp-code.app",
    "productName": "rp-code",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "!resources/bin/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../examples/packs/luna",
        "to": "packs/luna",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/quickjs-emscripten*/**",
      "**/esbuild/**",
      "**/@esbuild/**",
      "**/@jitl/quickjs-*/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "executableName": "rp-code",
      "maintainer": "rp-code contributors"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": null
  },
  "author": {
    "name": "rp-code contributors"
  },
  "homepage": "https://github.com/0xbeef1eaf/llm-rp-code",
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.2",
    "@esbuild/linux-arm64": "0.28.2",
    "@esbuild/win32-x64": "0.28.2",
    "@esbuild/win32-arm64": "0.28.2",
    "@esbuild/darwin-x64": "0.28.2",
    "@esbuild/darwin-arm64": "0.28.2"
  }
}
