    "@rp/sandbox": "workspace:*",
    "@rp/core": "workspace:*",
    "quickjs-emscripten": "^0.32.0",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "marked": "^15.0.0",
    "dompurify": "^3.2.0"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-vite": "^5.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^22",
    "@types/dompurify": "^3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
