{
  "name": "@rp/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "RPChat desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build-native.mjs && node scripts/build-extension.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "package": "node scripts/build-native.mjs && node scripts/build-extension.mjs && electron-vite build && electron-builder",
    "build:native": "node scripts/build-native.mjs",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "dependencies": {
    "@rp/core": "workspace:*",
    "@rp/llm": "workspace:*",
    "@rp/pack": "workspace:*",
    "@rp/sandbox": "workspace:*",
    "@rp/sdk": "workspace:*",
    "@rp/shared": "workspace:*",
    "dompurify": "^3.2.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "marked": "^15.0.0",
    "qrcode-generator": "2.0.4",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sherpa-onnx-node": "^1.13.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/dompurify": "^3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsqr": "1.4.0",
    "playwright-core": "1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "dev.rpchat.app",
    "productName": "RPChat",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "!resources/bin/**",
      "!resources/system/**",
      "!resources/extension/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/system",
        "to": "system",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      },
      {
        "from": "../../examples/packs/luna",
        "to": "packs/luna",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/quickjs-emscripten*/**",
      "**/esbuild/**",
      "**/@esbuild/**",
      "**/@jitl/quickjs-*/**",
      "**/sherpa-onnx-node/**",
      "**/sherpa-onnx-linux-*/**",
      "**/sherpa-onnx-darwin-*/**",
      "**/sherpa-onnx-win-*/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "rpchat",
      "maintainer": "RPChat contributors"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "0xbeef1eaf",
      "repo": "RPChat",
      "releaseType": "release"
    },
    "deb": {
      "afterInstall": "resources/deb-after-install.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libayatana-appindicator3-1 | libappindicator3-1",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "author": {
    "name": "RPChat contributors"
  },
  "homepage": "https://github.com/0xbeef1eaf/RPChat",
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.28.2",
    "@esbuild/darwin-x64": "0.28.2",
    "@esbuild/linux-arm64": "0.28.2",
    "@esbuild/linux-x64": "0.28.2",
    "@esbuild/win32-arm64": "0.28.2",
    "@esbuild/win32-x64": "0.28.2"
  }
}
