    "card": "A test card / calibration image",
    "colour-bars": "Colour-bar test pattern"
  },
  "entries": [
    { "match": "media/images/luna-*.png", "tags": ["portrait"] },
    {
      "match": "media/images/luna-smile.png",
      "tags": ["smile", "happy"],
      "description": "Luna grinning in warm light; the one where the lighting finally came out right."
    },
    {
      "match": "media/images/luna-wave.png",
      "tags": ["wave", "greeting"],
      "description": "Luna waving hello, cool blue background."
    },
    {
      "match": "media/images/teal-card.png",
      "tags": ["test", "solid", "card"],
      "description": "A flat teal test card."
    },
    {
      "match": "media/audio/chime.wav",
      "tags": ["chime", "notification", "gentle"],
      "description": "A soft two-tone chime, about half a second long."
    },
    {
      "match": "media/video/**",
      "tags": ["test", "colour-bars"],
      "description": "Colour-bar test pattern clip."
    }
  ]
