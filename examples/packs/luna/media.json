{
  "folderTags": true,
  "tags": {
    "portrait": "A picture of Luna herself",
    "smile": "Luna smiling",
    "happy": "Cheerful mood; good for celebrating or cheering someone up",
    "wave": "Luna waving",
    "greeting": "Suitable for hello / welcome-back moments",
    "chime": "A short bell-like sound",
    "notification": "Use to get the user's attention when a reminder fires",
    "gentle": "Quiet and unobtrusive",
    "test": "Placeholder test media, not a picture of Luna; only show if asked",
