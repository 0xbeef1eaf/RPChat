{
  "version": 1,
  "managedBy": "Everything on: the app cannot be quit or taken apart, a conversation stays open, development switches are off, the session is guarded (replace \"alice\" with your user name)",
  "settings": {
    "permissions": { "moduleAllow": {} },
    "updates": { "enabled": true, "automatic": true, "allowDowngrade": false }
  },
  "inputLock": {
    "enabled": true,
    "maxDurationMs": 300000,
    "emergencyKey": "esc",
    "emergencyHoldMs": 5000
  },
  "app": {
    "allowQuit": false,
    "users": ["alice"],
    "allowPackEditor": false,
    "allowPackRemove": false,
    "allowPackInstall": false,
    "allowDeleteSession": false,
    "allowDeleteHistory": false,
    "allowDeleteMemories": false,
    "allowRemoveEvents": false,
    "allowSandbox": false,
    "requireCharacterSession": true
  },
  "dev": {
    "allow": false,
    "devTools": false
  },
  "guard": {
    "mode": "enforce",
    "protectApp": true,
    "wallpaper": true,
    "compositorIpc": "shell-only",
    "shell": "auto",
    "extraDenyPaths": [],
    "extraDenySockets": [],
    "allowBinaries": []
  }
}
