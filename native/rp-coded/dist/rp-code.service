# rp-code — systemd *user* unit alternative to the XDG autostart entry.
# Installed to ~/.config/systemd/user/rp-code.service by install.sh --autostart systemd and
# enabled with `systemctl --user enable --now rp-code`. install.sh replaces the executable path.
[Unit]
Description=rp desktop app (start hidden in the tray)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=rp-code --hidden
Restart=on-failure
RestartSec=5
Slice=app.slice

[Install]
WantedBy=graphical-session.target
