# rp-coded — input lock / injection daemon for the rp desktop app.
# Installed to /etc/systemd/system/rp-coded.service by native/rp-coded/install.sh.
[Unit]
Description=rp-code input lock and injection daemon
Documentation=file:///usr/local/libexec/rp-code/README.md
After=systemd-udevd.service systemd-modules-load.service
Wants=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/rp-code/rp-coded
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

# Runs as root: EVIOCGRAB on /dev/input/event* and /dev/uinput need it. The daemon itself is
# locked down, but it also relaunches the desktop app as the user when the policy says
# `app.allowQuit: false` (see README "Keepalive"), and a child inherits every sandbox option of
# this unit. So the options that would break a desktop application are left out on purpose:
# ProtectHome / PrivateTmp (the app needs $HOME, /tmp/.X11-unix and the AppImage FUSE mount),
# ProtectSystem=strict (the app writes under ~/.config), MemoryDenyWriteExecute (V8 JIT),
# RestrictNamespaces (Chromium's sandbox), SystemCallFilter and DevicePolicy=closed (GPU, audio).
# What stays: no-new-privileges, read-only /usr and /etc (except /etc/rp-code), kernel/cgroup
# protection, a capability bounding set of just chown + setuid/setgid, and only the address
# families the app needs. Relaunched apps keep running when the daemon stops (KillMode=process).
User=root
NoNewPrivileges=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# CAP_CHOWN/CAP_FOWNER/CAP_DAC_OVERRIDE: hand the socket to the rp-code group. CAP_SETUID/
# CAP_SETGID: drop to the user (setgid, initgroups, setuid) before exec'ing a relaunched app.
# CAP_MAC_ADMIN: load/unload the session-guard AppArmor profiles (apparmor_parser writes
# /sys/kernel/security/apparmor/.replace, which the kernel gates on this capability).
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_MAC_ADMIN
# AF_UNIX for the daemon; the rest for the relaunched app (Chromium needs netlink too).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
KillMode=process
# Socket directory: created 0750 and chowned root:rp-code by the daemon. /etc/rp-code is the
# only writable path under /etc: the daemon creates policy.json there once (`set-policy`,
# write-once) and never modifies or removes it. The directory is created by install.sh before
# the service starts ("-": ignored when missing, so the unit still starts without it).
RuntimeDirectory=rp-code
RuntimeDirectoryMode=0750
ReadWritePaths=/run/rp-code
ReadWritePaths=-/etc/rp-code
# System install (`apply-update`): the unpacked app under /opt/rp-code (current/, previous/,
# versions.json, per-user staging), and — when the new bundle ships a newer daemon — the
# daemon's own files: the binary directory, this unit, the udev rule, the module list and the
# menu entry/icon, refreshed through the bundle's install.sh --refresh-daemon-files. All "-":
# ignored when missing, so the unit starts on machines without a system install.
ReadWritePaths=-/opt/rp-code
ReadWritePaths=-/usr/local/libexec/rp-code
ReadWritePaths=-/usr/local/bin
ReadWritePaths=-/etc/systemd/system
ReadWritePaths=-/etc/udev/rules.d
ReadWritePaths=-/etc/modules-load.d
ReadWritePaths=-/usr/local/share/applications
ReadWritePaths=-/usr/local/share/icons
# Session guard (`policy.guard`, README "Session guard"): the generated profiles under
# /etc/apparmor.d/rp-code-*, the state file in /etc/rp-code (already writable) and AppArmor's
# securityfs interface, which ProtectKernelTunables would otherwise leave read-only. Both "-":
# absent on machines without AppArmor. The audit tail reads the journal files (allowed under
# ProtectKernelLogs); the /dev/kmsg fallback is only reachable when that option is removed.
ReadWritePaths=-/etc/apparmor.d
ReadWritePaths=-/sys/kernel/security/apparmor

[Install]
WantedBy=multi-user.target
