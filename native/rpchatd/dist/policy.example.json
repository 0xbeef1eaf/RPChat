{
  "version": 1,
  "managedBy": "Example: the household admin (edit or remove this line)",
  "settings": {
    "maxInputLockMs": 120000,
    "autonomy": {
      "maxSelfWakesPerHour": 30,
      "maxConsecutiveSelfWakes": 10,
      "maxTimersPerSession": 20,
      "minRepeatIntervalMs": 60000
    },
    "permissions": {
      "moduleAllow": {
        "input": true
      }
    },
    "web": {
      "allowlist": []
    },
    "desktop": {
      "launchAllowlist": []
    },
    "memory": {},
    "senses": {
      "includeInPrompt": true,
      "watchDirs": [],
      "calendarSources": []
    },
    "displayBackend": "auto",
    "updates": {
      "automatic": true,
      "enabled": true,
      "allowDowngrade": false
    },
    "browser": {
      "allowBlocking": true,
      "allowEval": true,
      "allowHistory": true,
      "homePage": ""
    }
  },
  "inputLock": {
    "enabled": true,
    "maxDurationMs": 120000,
    "emergencyKey": "esc",
    "emergencyHoldMs": 5000
  },
  "app": {
    "allowQuit": true,
    "users": ["alice"],
    "allowPackEditor": true,
    "allowPackRemove": true,
    "allowPackInstall": true,
    "allowStopGeneration": true,
    "allowDeleteSession": true,
    "allowDeleteHistory": true,
    "allowDeleteMemories": true,
    "allowRemoveEvents": true,
    "allowSandbox": true,
    "requireCharacterSession": false
  },
  "dev": {
    "allow": true,
    "devTools": true
  },
  "guard": {
    "mode": "off",
    "protectApp": true,
    "wallpaper": true,
    "compositorIpc": "shell-only",
    "shell": "auto",
    "extraDenyPaths": [],
    "extraDenySockets": [],
    "allowBinaries": []
  },
  "remote": {
    "url": "https://example.com/rpchat/chain.json",
    "enabled": true,
    "intervalMinutes": 60
  },
  "packs": {
    "sources": [
      {
        "id": "luna",
        "url": "https://example.com/rpchat/luna.rppack",
        "signature": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==",
        "version": "1.0.0"
      }
    ],
    "removeUnlisted": false,
    "refreshMinutes": 360
  },
  "lock": {
    "digits": 6,
    "period": 30,
    "window": 1,
    "selfHeal": true,
    "immutable": true,
    "refuseManualStop": true,
    "denyEscapes": true
  }
}
