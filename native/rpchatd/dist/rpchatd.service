# rpchatd — input lock / injection daemon for the rp desktop app.
# Installed to /etc/systemd/system/rpchatd.service by native/rpchatd/install.sh.
[Unit]
Description=rpchat input lock and injection daemon
Documentation=file:///usr/local/libexec/rpchat/README.md
After=systemd-udevd.service systemd-modules-load.service
Wants=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/rpchat/rpchatd
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

# Runs as root: EVIOCGRAB on /dev/input/event* and /dev/uinput need it. The daemon itself is
# locked down, but it also relaunches the desktop app as the user when the policy says
# `app.allowQuit: false` (see README "Keepalive"), and a child inherits every sandbox option of
# this unit. So the options that would break a desktop application are left out on purpose:
# ProtectHome / PrivateTmp (the app needs $HOME, /tmp/.X11-unix and the AppImage FUSE mount),
# ProtectSystem=strict (the app writes under ~/.config), MemoryDenyWriteExecute (V8 JIT),
# RestrictNamespaces (Chromium's sandbox), SystemCallFilter and DevicePolicy=closed (GPU, audio).
# What stays: no-new-privileges, read-only /usr and /etc (except /etc/rpchat), kernel/cgroup
# protection, a capability bounding set of just chown + setuid/setgid, and only the address
# families the app needs. Relaunched apps keep running when the daemon stops (KillMode=process).
User=root
NoNewPrivileges=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# CAP_CHOWN/CAP_FOWNER/CAP_DAC_OVERRIDE: hand the socket to the rpchat group. CAP_SETUID/
# CAP_SETGID: drop to the user (setgid, initgroups, setuid) before exec'ing a relaunched app.
# CAP_MAC_ADMIN: load/unload the session-guard AppArmor profiles (apparmor_parser writes
# /sys/kernel/security/apparmor/.replace, which the kernel gates on this capability).
# CAP_SYS_ADMIN: mount and remount the runtime policy filesystem (/run/rpchat/policy) — the
# one thing here that needs it, and the reason the seal can publish a policy root cannot edit
# in place. CAP_LINUX_IMMUTABLE: set FS_IMMUTABLE_FL on the policy, the seal and its mirrors
# (`lock.immutable`), which the kernel gates on that capability alone. CAP_BPF/CAP_PERFMON:
# load and attach the IPC guard's BPF LSM program (README "Session guard"). CAP_SYS_ADMIN
# already implies both — `bpf_capable()` and `perfmon_capable()` accept it — but naming them
# says what the daemon actually uses, and keeps it working if CAP_SYS_ADMIN is ever dropped.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_MAC_ADMIN CAP_SYS_ADMIN CAP_LINUX_IMMUTABLE CAP_BPF CAP_PERFMON
# The bounding set is not enough. NoNewPrivileges=yes together with any option that installs a
# seccomp filter (ProtectClock, ProtectKernelTunables/Modules/Logs, ProtectHostname,
# RestrictRealtime, RestrictSUIDSGID, LockPersonality, SystemCallArchitectures — this unit has
# most of them) makes systemd leave CAP_SETUID out of the *permitted* set, even for User=root:
# the bounding set still lists it, but setuid() returns EPERM. That breaks both things the
# daemon drops privileges for — relaunching the app for `app.allowQuit: false` and extracting
# an update as the user — with "Operation not permitted (os error 1)". Naming them here puts
# them back in the permitted set. They do not leak into the relaunched app: the pre_exec does
# setgid/initgroups/setuid before execve, which clears the permitted, effective and ambient
# sets (only the inheritable bits remain, and those grant nothing under NoNewPrivileges).
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_SYS_ADMIN CAP_LINUX_IMMUTABLE
# AF_UNIX for the daemon; the rest for the relaunched app (Chromium needs netlink too).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
KillMode=process
# Socket directory: created 0750 and chowned root:rpchat by the daemon. /etc/rpchat is the
# only writable path under /etc: the daemon creates policy.json there once (`set-policy`,
# write-once) and never modifies or removes it. The directory is created by install.sh before
# the service starts ("-": ignored when missing, so the unit still starts without it).
RuntimeDirectory=rpchat
RuntimeDirectoryMode=0750
ReadWritePaths=/run/rpchat
ReadWritePaths=-/etc/rpchat
# The policy seal (README "Sealing the policy"): its mirror copies live outside /etc so that
# removing one place does not unseal the machine. Both "-": created on the first seal.
ReadWritePaths=-/var/lib/rpchat
# The runtime policy filesystem (/run/rpchat/policy) is a tmpfs the daemon mounts itself and
# remounts read-only after each publish. A unit with sandboxing options runs in its own mount
# namespace whose propagation systemd sets to `slave` by default, which would keep that mount
# invisible to the rest of the machine — including the app that has to read it. `shared` lets
# the mounts this daemon makes propagate out to the host, which is what this setting is for.
# The sandbox mounts systemd sets up are made before the propagation mode is applied, so they
# stay inside the namespace; only the daemon's own later mounts travel.
MountFlags=shared
# System install (`apply-update`): the unpacked app under /opt/rpchat (current/, previous/,
# versions.json, per-user staging), and — when the new bundle ships a newer daemon — the
# daemon's own files: the binary directory, this unit, the udev rule, the module list and the
# menu entry/icon, refreshed through the bundle's install.sh --refresh-daemon-files. All "-":
# ignored when missing, so the unit starts on machines without a system install.
ReadWritePaths=-/opt/rpchat
ReadWritePaths=-/usr/local/libexec/rpchat
ReadWritePaths=-/usr/local/bin
ReadWritePaths=-/etc/systemd/system
ReadWritePaths=-/etc/udev/rules.d
ReadWritePaths=-/etc/modules-load.d
ReadWritePaths=-/usr/local/share/applications
ReadWritePaths=-/usr/local/share/icons
# Session guard (`policy.guard`, README "Session guard"): the generated profiles under
# /etc/apparmor.d/rpchat-*, the state file in /etc/rpchat (already writable) and AppArmor's
# securityfs interface, which ProtectKernelTunables would otherwise leave read-only. Both "-":
# absent on machines without AppArmor. The audit tail reads the journal files (allowed under
# ProtectKernelLogs); the /dev/kmsg fallback is only reachable when that option is removed.
ReadWritePaths=-/etc/apparmor.d
ReadWritePaths=-/sys/kernel/security/apparmor
# The IPC guard pins its BPF program under /sys/fs/bpf/rpchat so a killed daemon does not drop
# the mediation; ProtectKernelTunables leaves the whole of /sys read-only without this. "-":
# absent on a machine with no bpffs, where the program is not loaded at all.
ReadWritePaths=-/sys/fs/bpf

[Install]
WantedBy=multi-user.target
