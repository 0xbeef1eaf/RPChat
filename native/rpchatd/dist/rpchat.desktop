[Desktop Entry]
Type=Application
Version=1.0
Name=RPChat
GenericName=Roleplay chat
Comment=LLM roleplay characters that act on your desktop
# install.sh replaces the executable with the detected app path (--app-bin).
Exec=rpchat %U
TryExec=rpchat
Icon=rpchat
Terminal=false
Categories=Utility;Network;Chat;
Keywords=roleplay;chat;character;llm;ai;
StartupNotify=true
StartupWMClass=rpchat
